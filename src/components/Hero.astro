---
import { Icon } from 'astro-icon/components';
import { site, stack } from '../data/site';
import type { Dict } from '../i18n/en';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section class="hero" id="home">
  <div class="hero__bg" aria-hidden="true"></div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow reveal">{t.hero.eyebrow}</p>
      <h1 class="hero__title reveal" style="--d: 0.08s">
        {t.hero.titlePre}<span class="hl">{t.hero.titleHl}</span>
      </h1>
      <p class="hero__text reveal" style="--d: 0.16s">{t.hero.intro}</p>

      <div class="hero__cta reveal" style="--d: 0.24s">
        <a href="#contact" class="btn btn--red">
          {t.cta} <Icon name="lucide:arrow-up-right" size={16} />
        </a>
        <a href="#services" class="btn">{t.hero.secondary}</a>
      </div>

      <ul class="chips reveal" style="--d: 0.32s" aria-label={t.a11y.stack}>
        {stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>

    <div class="hero__visual reveal" style="--d: 0.2s">
      <div class="glow" aria-hidden="true"></div>
      <img src="/img/denis.png" alt={t.a11y.portrait} width="450" height="440" class="portrait" fetchpriority="high" />
      <div class="stat">
        <strong>{site.years}<em>+</em></strong>
        <span set:html={t.hero.years} />
      </div>
    </div>
  </div>

  <a href="#services" class="scroll" aria-label="Scroll down">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 920px);
    display: flex;
    align-items: center;
    padding: 130px 0 90px;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 55% at 78% 40%, rgba(225, 29, 46, 0.22), transparent 70%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 80px 80px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 80px 80px;
    -webkit-mask-image: radial-gradient(90% 80% at 70% 40%, #000 20%, transparent 85%);
    mask-image: radial-gradient(90% 80% at 70% 40%, #000 20%, transparent 85%);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(32px, 6vw, 90px);
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0 0 1.6rem;
  }
  .hl {
    color: #fff;
    background: var(--red);
    padding: 0 0.18em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .hero__text {
    max-width: 54ch;
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0 0 2.2rem;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
    margin: 2.6rem 0 0;
  }
  .chips li {
    font-size: 0.8rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.02);
  }

  .hero__visual {
    position: relative;
    display: grid;
    place-items: center;
  }
  .glow {
    position: absolute;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(225, 29, 46, 0.55), transparent 68%);
    filter: blur(40px);
    animation: pulse 6s ease-in-out infinite;
  }
  .portrait {
    position: relative;
    width: min(100%, 440px);
    height: auto;
    filter: saturate(0.9) contrast(1.05) drop-shadow(0 30px 50px rgba(0, 0, 0, 0.6));
    animation: float 8s ease-in-out infinite;
  }
  .stat {
    position: absolute;
    left: -2%;
    bottom: 6%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 22px;
    background: rgba(13, 13, 14, 0.8);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line);
  }
  .stat strong {
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    font-weight: 600;
  }
  .stat em {
    color: var(--red);
    font-style: normal;
  }
  .stat span {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.4;
  }

  .scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: 22px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 12px;
    transform: translateX(-50%);
  }
  .scroll span {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 2px;
    height: 7px;
    margin-left: -1px;
    background: var(--red);
    border-radius: 2px;
    animation: scroll 1.8s ease-in-out infinite;
  }

  @keyframes float {
    50% {
      transform: translateY(-12px);
    }
  }
  @keyframes pulse {
    50% {
      opacity: 0.65;
      transform: scale(1.06);
    }
  }
  @keyframes scroll {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 110px;
    }
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      order: -1;
      max-width: 320px;
      margin-inline: auto;
    }
    .stat {
      left: 0;
    }
    .scroll {
      display: none;
    }
  }
</style>
