---
import { Icon } from 'astro-icon/components';
import type { Dict } from '../i18n/en';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section class="section" id="services">
  <div class="container">
    <header class="head">
      <p class="eyebrow reveal">{t.services.eyebrow}</p>
      <h2 class="h2 reveal" style="--d: 0.08s">{t.services.title}</h2>
    </header>

    <div class="grid">
      {
        t.services.items.map((s, i) => (
          <article class="card reveal" data-glow style={`--d: ${(i % 3) * 0.08}s`}>
            <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
            <div class="card__icon">
              <Icon name={s.icon} size={28} stroke-width={1.5} />
            </div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .card {
    --mx: 50%;
    --my: 50%;
    position: relative;
    padding: clamp(28px, 3.2vw, 44px);
    background: var(--bg);
    overflow: hidden;
    transition: background 0.4s var(--ease);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(320px circle at var(--mx) var(--my), rgba(225, 29, 46, 0.16), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .card:hover::before {
    opacity: 1;
  }
  .card__num {
    position: absolute;
    top: 24px;
    right: 28px;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.25);
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 28px;
    color: var(--red);
    border: 1px solid var(--line);
    transition: background 0.4s var(--ease), color 0.4s, transform 0.4s var(--ease);
  }
  .card:hover .card__icon {
    background: var(--red);
    color: #fff;
    transform: translateY(-4px);
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    margin: 0 0 0.7rem;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
