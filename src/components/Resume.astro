---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import type { Dict } from '../i18n/en';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const r = t.resume;
---

<section class="section resume" id="resume">
  <div class="container">
    <header class="head">
      <p class="eyebrow reveal">{site.years}+ {r.eyebrow}</p>
      <h2 class="h2 reveal" style="--d: 0.08s">{r.title}</h2>
    </header>

    <div class="jobs">
      {
        r.jobs.map((j, i) => (
          <article class="job reveal" style={`--d: ${i * 0.05}s`}>
            <div class="job__when">
              <span class="period">{j.period}</span>
              <span class="place">{j.place}</span>
            </div>

            <div class="job__main">
              <h3>{j.role}</h3>
              <p class="company">{j.company}</p>

              {j.metrics.length > 0 && (
                <ul class="metrics">
                  {j.metrics.map((m) => (
                    <li>
                      <strong>{m.value}</strong>
                      <span>{m.label}</span>
                    </li>
                  ))}
                </ul>
              )}

              <ul class="bullets">
                {j.bullets.map((b) => <li>{b}</li>)}
              </ul>

              <ul class="tags" aria-label={r.stackLabel}>
                {j.stack.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="extra">
      <div class="block reveal">
        <h3 class="block__title"><Icon name="lucide:graduation-cap" size={20} />{r.educationTitle}</h3>
        <p class="strong">{r.degree.title}</p>
        <p class="sub">{r.degree.place} · {r.degree.note}</p>
      </div>

      <div class="block award reveal" style="--d: 0.1s">
        <h3 class="block__title"><Icon name="lucide:award" size={20} />{r.awardTitle}</h3>
        <p class="strong">{r.award.title} <span class="year">· {r.award.year}</span></p>
        <p class="sub">{r.award.text}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  /* Experiências */
  .jobs {
    border-bottom: 1px solid var(--line);
  }
  .job {
    position: relative;
    display: grid;
    grid-template-columns: minmax(150px, 0.3fr) 1fr;
    gap: clamp(20px, 4vw, 64px);
    padding: clamp(32px, 4vw, 52px) 0;
    border-top: 1px solid var(--line);
  }
  .job::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 1px;
    width: 100%;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }
  .job:hover::before {
    transform: scaleX(1);
  }

  .job__when {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .period {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .place {
    font-size: 0.85rem;
    color: var(--muted);
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0;
  }
  .company {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--red);
  }

  .metrics {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .metrics li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .metrics strong {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1;
  }
  .metrics span {
    max-width: 14ch;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    line-height: 1.35;
  }

  .bullets {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .bullets li {
    position: relative;
    padding-left: 22px;
    color: #c9c9ce;
    font-size: 0.97rem;
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 1px;
    background: var(--red);
  }

  .tags {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags li {
    font-size: 0.75rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
  }

  /* Formação e premiação */
  .extra {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: clamp(40px, 6vw, 80px);
  }
  .block {
    padding: clamp(24px, 3vw, 36px);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .block__title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 1.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .block__title :global(svg) {
    color: var(--red);
  }
  .strong {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .year {
    color: var(--red);
  }
  .sub {
    margin: 8px 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .job {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .job__when {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px 14px;
    }
    .extra {
      grid-template-columns: 1fr;
    }
  }
</style>
