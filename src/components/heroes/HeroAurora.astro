---
// Variante: fundo "aurora" animado, texto centralizado
import { Icon } from 'astro-icon/components';
import { site, stack } from '../../data/site';
import type { Dict } from '../../i18n/en';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section class="hx-hero" id="home">
  <div class="aurora" aria-hidden="true">
    <span class="b b1"></span>
    <span class="b b2"></span>
    <span class="b b3"></span>
  </div>
  <div class="hx-grid" aria-hidden="true"></div>

  <div class="container center">
    <p class="badge reveal"><i aria-hidden="true"></i>{t.hero.badge}</p>
    <p class="eyebrow reveal" style="--d: 0.04s">{t.hero.eyebrow}</p>
    <h1 class="hx-title big reveal" style="--d: 0.08s">{t.hero.titlePre}<span class="hx-hl">{t.hero.titleHl}</span></h1>
    <p class="hx-text reveal" style="--d: 0.16s">{t.hero.intro}</p>
    <div class="hx-cta reveal" style="--d: 0.24s">
      <a href="#contact" class="btn btn--red">{t.cta} <Icon name="lucide:arrow-up-right" size={16} /></a>
      <a href="#services" class="btn">{t.hero.secondary}</a>
    </div>

    <div class="meta reveal" style="--d: 0.32s">
      <div class="stat"><strong>{site.years}<em>+</em></strong><span set:html={t.hero.years} /></div>
      <ul class="hx-chips" aria-label={t.a11y.stack}>
        {stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 1.6rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(8px);
    font-size: 0.8rem;
    color: var(--text);
  }
  .badge i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6);
    animation: ping 2s ease-out infinite;
  }
  @keyframes ping {
    to { box-shadow: 0 0 0 9px rgba(61, 220, 132, 0); }
  }
  .big {
    max-width: 16em;
    font-size: clamp(2.1rem, 4.8vw, 4rem);
  }
  .center :global(.hx-text) {
    margin-inline: auto;
  }
  .center :global(.hx-cta) {
    justify-content: center;
  }
  .meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 28px 44px;
    margin-top: 3rem;
    padding-top: 2.2rem;
    border-top: 1px solid var(--line);
  }
  .meta :global(.hx-chips) {
    margin: 0;
    justify-content: center;
  }
  .stat {
    display: flex;
    align-items: center;
    gap: 14px;
    text-align: left;
  }
  .stat strong {
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    font-weight: 600;
  }
  .stat em {
    color: var(--red);
    font-style: normal;
  }
  .stat span {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.4;
  }

  .aurora {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .b {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
  }
  .b1 {
    width: 46vw;
    height: 46vw;
    left: -8%;
    top: -12%;
    background: #e11d2e;
    animation: drift1 16s ease-in-out infinite alternate;
  }
  .b2 {
    width: 38vw;
    height: 38vw;
    right: -6%;
    top: 20%;
    background: #7a0c16;
    animation: drift2 20s ease-in-out infinite alternate;
  }
  .b3 {
    width: 30vw;
    height: 30vw;
    left: 38%;
    bottom: -18%;
    background: #ff4d5e;
    opacity: 0.3;
    animation: drift3 18s ease-in-out infinite alternate;
  }
  .aurora::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 50% 45%, transparent 0%, var(--bg) 100%);
  }
  @keyframes drift1 { to { transform: translate(18vw, 14vh) scale(1.15); } }
  @keyframes drift2 { to { transform: translate(-16vw, -10vh) scale(0.9); } }
  @keyframes drift3 { to { transform: translate(-14vw, -12vh) scale(1.2); } }
</style>
