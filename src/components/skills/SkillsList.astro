---
// Variante 3: lista editorial, uma categoria por linha
import type { Dict } from '../../i18n/en';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const s = t.skills;
---

<section class="skills" id="skills">
  <div class="container">
    <header class="head">
      <p class="eyebrow reveal">{s.eyebrow}</p>
      <h2 class="h2 reveal" style="--d: 0.08s">{s.title}</h2>
    </header>

    <div class="list">
      {
        s.groups.map((g, i) => (
          <div class="row reveal" style={`--d: ${i * 0.05}s`}>
            <div class="row__name">
              <span class="no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{g.name}</h3>
            </div>
            <ul>
              {g.items.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        ))
      }

      <div class="row row--langs reveal" style="--d: 0.25s">
        <div class="row__name">
          <span class="no">{String(s.groups.length + 1).padStart(2, '0')}</span>
          <h3>{s.languagesTitle}</h3>
        </div>
        <ul class="langs">
          {s.languages.map((l) => <li>{l.name} <em>{l.level}</em></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    padding-block: clamp(70px, 9vw, 120px);
    border-top: 1px solid var(--line);
  }
  .head {
    margin-bottom: clamp(32px, 4vw, 52px);
  }
  .list {
    border-bottom: 1px solid var(--line);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(190px, 0.3fr) 1fr;
    gap: clamp(16px, 4vw, 64px);
    align-items: baseline;
    padding: clamp(22px, 3vw, 34px) 0;
    border-top: 1px solid var(--line);
  }
  .row::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 100%;
    height: 1px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }
  .row:hover::before {
    transform: scaleX(1);
  }
  .row__name {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .no {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    color: var(--red);
  }
  h3 {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.3s;
  }
  .row:hover h3 {
    color: #fff;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
  }
  li {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3.2vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: #8d8d95;
    transition: color 0.3s;
  }
  li:not(:last-child)::after {
    content: '/';
    margin: 0 0.5em;
    color: rgba(255, 255, 255, 0.18);
  }
  .row:hover li {
    color: #fff;
  }
  .row li:hover {
    color: var(--red);
  }
  .langs li em {
    font-family: var(--font-body);
    font-size: 0.45em;
    font-style: normal;
    letter-spacing: 0.06em;
    color: var(--muted);
    vertical-align: middle;
  }
  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
