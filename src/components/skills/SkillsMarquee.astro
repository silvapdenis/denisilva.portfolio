---
// Variante 1: faixas rolando em sentidos opostos
import type { Dict } from '../../i18n/en';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const s = t.skills;

const all = [...new Set(s.groups.flatMap((g) => g.items))];
const half = Math.ceil(all.length / 2);
const rows = [all.slice(0, half), all.slice(half)];
---

<section class="skills" id="skills">
  <div class="container head">
    <p class="eyebrow reveal">{s.eyebrow}</p>
    <h2 class="h2 reveal" style="--d: 0.08s">{s.title}</h2>
  </div>

  <div class="rows reveal" aria-label={s.title}>
    {
      rows.map((row, i) => (
        <div class="marquee">
          <div class:list={['track', { rev: i === 1 }]} aria-hidden={i === 1 ? 'true' : undefined}>
            {[0, 1].map(() => row.concat(row).map((w) => <span>{w}<i>✦</i></span>))}
          </div>
        </div>
      ))
    }
  </div>

  <div class="container langs reveal">
    <span>{s.languagesTitle}</span>
    {s.languages.map((l) => <b>{l.name} <em>{l.level}</em></b>)}
  </div>
</section>

<style>
  .skills {
    padding-block: clamp(70px, 9vw, 120px);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .head {
    margin-bottom: clamp(32px, 4vw, 52px);
  }
  .rows {
    display: grid;
    gap: 10px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee {
    overflow: hidden;
  }
  .track {
    display: flex;
    width: max-content;
    animation: roll 45s linear infinite;
  }
  .track.rev {
    animation-direction: reverse;
    animation-duration: 55s;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .track span {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    padding-right: clamp(1.4rem, 3vw, 2.6rem);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.2rem, 5.5vw, 4.4rem);
    letter-spacing: -0.03em;
    line-height: 1.25;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.4);
    transition: color 0.3s;
  }
  .track span:hover {
    color: #fff;
  }
  .track.rev span {
    color: #fff;
    -webkit-text-stroke: 0;
  }
  .track.rev span:hover {
    color: var(--red);
  }
  .track i {
    font-style: normal;
    font-size: 0.4em;
    color: var(--red);
    -webkit-text-stroke: 0;
  }
  @keyframes roll {
    to { transform: translateX(-50%); }
  }

  .langs {
    margin-top: clamp(32px, 4vw, 52px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 36px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .langs span {
    font-size: 0.74rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--red);
  }
  .langs b {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .langs em {
    margin-left: 6px;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--muted);
  }
</style>
